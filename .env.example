# Worker and reviewer connections are independent so one model does not grade itself.
FORGE_WORKER_MODEL=openai/gemini-3.5-flash-lite
FORGE_WORKER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FORGE_WORKER_API_KEY=

FORGE_REVIEWER_MODEL=openai/zai-org/GLM-5.3-Flash
FORGE_REVIEWER_BASE_URL=https://api.featherless.ai/v1
FORGE_REVIEWER_API_KEY=

# Optional separate compiler/auditor connections; blank means reviewer connection.
FORGE_COMPILER_MODEL=
FORGE_COMPILER_BASE_URL=
FORGE_COMPILER_API_KEY=
FORGE_AUDITOR_MODEL=
FORGE_AUDITOR_BASE_URL=
FORGE_AUDITOR_API_KEY=

FORGE_RESEARCH_FLOORS=6
FORGE_BUILD_FLOORS=6
FORGE_MAX_CORRECTIONS=3
# Strict default: unresolved notes do not release a floor.
FORGE_ALLOW_PASS_WITH_NOTES=false
FORGE_WORKER_MAX_ITER=25
FORGE_REVIEWER_MAX_ITER=12
FORGE_COMPILER_MAX_ITER=12
FORGE_AUDITOR_MAX_ITER=15
FORGE_WORKSPACE=./workspace
FORGE_STATE_DIR=.forge2
FORGE_VERBOSE=true

# Optional tools.
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
FORGE_GITHUB_REPOSITORY=
